[1,0,0,[["cc.JsonAsset",["_name","json"],1]],[[0,0,1,3]],[[0,"IdeaAttr3",{"11001":{"IdeaType":4,"IdeaName":"蓝图-干木头","Content":"晾干了的木头，似乎是个不错的生火材料。","SynthesisID":100001},"11002":{"IdeaType":4,"IdeaName":"蓝图-木棍","Content":"很结实的棍子，一下子就能把你的...额...椰子砸开。","SynthesisID":109001},"11004":{"IdeaType":4,"IdeaName":"蓝图-塑料桶","Content":"再造的塑料桶，良好的贯彻了环保理念。","SynthesisID":100004},"11006":{"IdeaType":4,"IdeaName":"蓝图-纤维","Content":"强韧如发丝，等等，你问我什么是发丝？","SynthesisID":109002},"11007":{"IdeaType":4,"IdeaName":"蓝图-绳子","Content":"方便别人救你的神器","SynthesisID":109003},"11008":{"IdeaType":4,"IdeaName":"蓝图-布","Content":"擦完船还可以擦身子","SynthesisID":100008},"11009":{"IdeaType":4,"IdeaName":"蓝图-碳","Content":"用船烧剩下的东西","SynthesisID":100009},"11011":{"IdeaType":0,"IdeaName":"蓝图-木屋","Content":"船上的小屋，为二人世界创造愉快的空间","SynthesisID":109004},"11013":{"IdeaType":0,"IdeaName":"蓝图-晾晒架","Content":"要记住，使用晾晒架的第一步就是把晾晒架晾干。","SynthesisID":109005},"11014":{"IdeaType":1,"IdeaName":"蓝图-锯木工坊","Content":"这哪是锯木头，这是干磨啊。","SynthesisID":109006},"11017":{"IdeaType":1,"IdeaName":"蓝图-钓鱼台","Content":"钓鱼要有仪式感，万一钓上来个鲨鱼呢。","SynthesisID":109028},"11019":{"IdeaType":1,"IdeaName":"蓝图-纺织机","Content":"不要再当咸鱼了，小心被拿来当成梭子。","SynthesisID":109009},"11020":{"IdeaType":1,"IdeaName":"蓝图-塑料加工厂","Content":"简易的加热装置，能帮助你把塑料重新塑形。","SynthesisID":109010},"11021":{"IdeaType":1,"IdeaName":"蓝图-熔炉","Content":"这个东西能帮你冶炼矿石，还能帮你烧了你的船。","SynthesisID":109011},"11023":{"IdeaType":1,"IdeaName":"蓝图-大炮","Content":"大人，时代又变了","SynthesisID":101012},"11024":{"IdeaType":1,"IdeaName":"蓝图-龙骨","Content":"等等，你不会真以为这是龙的骨头吧？","SynthesisID":101013},"11025":{"IdeaType":1,"IdeaName":"蓝图-船帆","Content":"听说用兽皮的质量更好，当然，你能找到野兽的话","SynthesisID":101014},"11026":{"IdeaType":1,"IdeaName":"蓝图-船锚","Content":"能把船牢牢定在海里，走都走不动","SynthesisID":101015},"11027":{"IdeaType":1,"IdeaName":"蓝图-甲板","Content":"练习跳水的好地方","SynthesisID":101016},"11028":{"IdeaType":1,"IdeaName":"蓝图-海盗船","Content":"你用金钱结交的好朋友，生死之交","SynthesisID":101017},"11029":{"IdeaType":2,"IdeaName":"蓝图-鱼干","Content":"干瘪瘪的鱼，鲨鱼可不算","Synthes